body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    color: #333;
    background-color: #f8f9fa;
}
header {
    background-color: #1a365d;
    color: white;
    padding: 2rem;
    text-align: center;
}
main {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
}
footer {
    background-color: #2d3748;
    color: white;
    text-align: center;
    padding: 1rem;
    position: fixed;
    bottom: 0;
    width: 100%;
}
